<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    __PUBLISHER__ and the Identity Name below must exactly match what
    Partner Center assigns when you reserve the app name (Dashboard ->
    App identity page). They are placeholders here on purpose — CI fills
    them from repo variables (APPX_IDENTITY_NAME / APPX_PUBLISHER /
    APPX_PUBLISHER_DISPLAY_NAME); until those are set, this package is
    valid for local sideload testing only, not Store submission.
  -->
  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CyberWarrior</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Defensive security dashboard: ingest-and-defend firewall, antivirus, vulnerability, and incident-response tooling.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <!-- Desktop Bridge: this is a normal Win32 exe, not a sandboxed UWP app. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="CyberWarrior" Executable="cyberwarrior.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="CyberWarrior"
        Description="Defensive security dashboard"
        BackgroundColor="#121214"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
